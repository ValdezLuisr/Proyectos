@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Iniciar sesión - Tutorías Académicas</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <style>
        .login-icon-user {
            width: 50px;
            height: 50px;
            border-radius: 14px;
            background: #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
        }

        body.login-page {
            min-height: 100vh;
            margin: 0;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: radial-gradient(circle at top left, #e3f2fd 0, #f5f7fb 40%, #e8eaf6 100%);
            font-family: "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
        }

        .login-card {
            background: #ffffff;
            border-radius: 18px;
            box-shadow: 0 18px 45px rgba(15, 23, 42, 0.12);
            max-width: 420px;
            width: 100%;
            padding: 32px 28px;
        }

        .login-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 8px;
        }

        .login-badge {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: linear-gradient(135deg, #1e88e5, #42a5f5);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 700;
            font-size: 18px;
        }

        .login-title {
            font-size: 20px;
            font-weight: 700;
            margin: 0;
            color: #1e293b;
        }

        .login-subtitle {
            font-size: 13px;
            margin: 4px 0 22px 0;
            color: #64748b;
        }

        .role-hint {
            font-size: 12px;
            color: #94a3b8;
            margin-bottom: 16px;
        }

        .form-label {
            font-weight: 600;
            font-size: 13px;
            color: #475569;
        }

        .form-control {
            border-radius: 10px;
            border-color: #cbd5f5;
            font-size: 14px;
        }

        .form-control:focus {
            border-color: #1e88e5;
            box-shadow: 0 0 0 0.15rem rgba(30, 136, 229, 0.25);
        }

        .btn-login {
            border-radius: 999px;
            font-weight: 600;
            letter-spacing: 0.03em;
        }

        .btn-primary {
            background: linear-gradient(135deg, #1e88e5, #1976d2);
            border: none;
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, #1976d2, #1565c0);
        }

        .text-muted {
            color: #94a3b8 !important;
        }

        .login-footer {
            margin-top: 18px;
            font-size: 11px;
            color: #9ca3af;
        }

        @@media (max-width: 576px) {
            .login-card {
                margin: 16px;
                padding: 24px 18px;
            }
        }

    </style>
</head>
<body class="login-page">
    <div class="login-card">
        <div class="login-brand">
            <div class="login-icon-user">
                <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" fill="#1e293b" viewBox="0 0 24 24">
                    <path d="M12 12c2.761 0 5-2.91 5-6.5S14.761 0 12 0 7 2.91 7 6.5 9.239 12 12 12zm0 2c-3.866 0-7 3.358-7 7.5V24h14v-2.5c0-4.142-3.134-7.5-7-7.5z" />
                </svg>
            </div>

            <div>
                <h1 class="login-title">Iniciar sesión</h1>
                <p class="login-subtitle mb-0">Acceso para estudiantes y docentes</p>
            </div>
        </div>


        <p class="role-hint">
            Usa tu correo institucional y contraseña asignada por el sistema.
        </p>

        @using (Html.BeginForm("Login", "Auth", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label for="correo" class="form-label">Correo institucional</label>
                <input type="email"
                       id="correo"
                       name="correo"
                       class="form-control"
                       placeholder="Usuario"
                       required />
            </div>

            <div class="mb-3">
                <label for="contrasena" class="form-label">Contraseña</label>
                <input type="password"
                       id="contrasena"
                       name="contraseña"
                       class="form-control"
                       placeholder="••••••••"
                       required />
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="recordarme" />
                    <label class="form-check-label" for="recordarme">Recordarme en este equipo</label>
                </div>
            </div>


            <button type="submit" class="btn btn-primary btn-login w-100 mb-2">
                Ingresar
            </button>
        }

        @if (ViewBag.Error != null && !string.IsNullOrWhiteSpace(ViewBag.Error.ToString()))
        {
            <div class="alert alert-danger mt-2" role="alert">
                @ViewBag.Error
            </div>
        }


        <div class="login-footer text-center">
            Acceso exclusivo para estudiantes y docentes registrados en el sistema de tutorías.
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
</body>
</html>
