@{
    Layout = null;
}

<h2>Iniciar Sesión</h2>

<form method="post">
    <label>Correo:</label>
    <input type="text" name="correo" required />

    <label>Contraseña:</label>
    <input type="password" name="contraseña" required />

    <button type="submit">Ingresar</button>

    <p style="color:red">@ViewBag.Error</p>
</form>

