@model Tutorias_Academicas.Models.Tutoria
@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@{
    ViewBag.Title = "Crear Tutoría";
}

<h2>Crear Tutoría</h2>

@using (Html.BeginForm("Crear", "Tutorias", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label>Materia</label>
        @Html.TextBoxFor(m => m.Materia, new { @class = "form-control", required = "required" })
        @Html.ValidationMessageFor(m => m.Materia, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        <label>Descripción</label>
        @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Descripcion, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        <label>Horario</label>
        @Html.TextBoxFor(m => m.Horario, new { @class = "form-control", placeholder = "Horario" })
        @Html.ValidationMessageFor(m => m.Horario, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        <label>Modalidad</label>
        @Html.TextBoxFor(m => m.Modalidad, new { @class = "form-control", placeholder = "Presencial / En línea" })
    </div>

    <div class="form-group">
        <label>Aula</label>
        @Html.TextBoxFor(m => m.Aula, new { @class = "form-control" })
    </div>


    <div class="form-group">
        <label>Cupo</label>
        @Html.TextBoxFor(m => m.Cupo, new { @class = "form-control", type = "number", min = "1", required = "required" })
        @Html.ValidationMessageFor(m => m.Cupo, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        <label>Maestro</label>
        @Html.DropDownListFor(
            m => m.MaestroId,
            (SelectList)ViewBag.Maestros,
            "Seleccionar Maestro",
            new { @class = "form-control", required = "required" }
        )
        @Html.ValidationMessageFor(m => m.MaestroId, "", new { @class = "text-danger" })
    </div>

    <br />

    <button type="submit" class="btn btn-success">Guardar</button>
    <a href="/Tutorias" class="btn btn-secondary">Cancelar</a>
}
