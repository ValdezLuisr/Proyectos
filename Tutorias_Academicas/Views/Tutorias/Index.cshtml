@model IEnumerable<Tutorias_Academicas.Models.Tutoria>

@{
    ViewBag.Title = "Listado de Tutorías";
}

<h2>Listado de Tutorías</h2>

<a href="@Url.Action("Crear", "Tutorias")" class="btn btn-primary mb-3">
    Crear Nueva Tutoría
</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Materia</th>
            <th>Descripción</th>
            <th>Horario</th>
            <th>Cupo</th>
            <th>Modalidad</th>
            <th>Aula</th>
            <th>Maestro</th>
            <th>Correo maestro</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.Materia</td>
                <td>@t.Descripcion</td>
                <td>@t.Horario</td>
                <td>@t.Cupo</td>
                <td>@t.Modalidad</td>
                <td>@t.Aula</td>
                <td>@(t.Maestro != null ? t.Maestro.NombreCompleto : "")</td>
                <td>@(t.Maestro != null ? t.Maestro.Correo : "")</td>

                <td>
                    <a href="@Url.Action("Detalles", "Tutorias", new { id = t.Id })"
                       class="btn btn-info btn-sm">
                        Detalles
                    </a>

                    <a href="@Url.Action("Editar", "Tutorias", new { id = t.Id })"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <a href="@Url.Action("Eliminar", "Tutorias", new { id = t.Id })"
                       class="btn btn-danger btn-sm">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

